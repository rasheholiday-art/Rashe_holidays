# ==============================================================================
# Rashe Holidays / Anand Holidays - Environment Variables
# Copy this file to .env and fill in your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Client Credentials (Used by React Frontend)
# Project Settings -> API
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ------------------------------------------------------------------------------
# 2. Supabase Server / Edge Function Credentials
# Project Settings -> API -> service_role key (NEVER expose to frontend)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# ------------------------------------------------------------------------------
# 3. Resend Email Integration
# Create an account at https://resend.com -> API Keys
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here

# The email address that receives notifications when new bookings are created
ADMIN_EMAIL=admin@yourdomain.com

# Verified sender address in Resend (default for testing is onboarding@resend.dev)
RESEND_FROM_EMAIL=Anand Holidays <onboarding@resend.dev>

# Brand name displayed in emails
COMPANY_NAME=Anand Holidays
